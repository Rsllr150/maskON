# MaskON configuration — copy to `.env` and adjust. Never commit your real .env.

# Secret key for the deterministic `hash` masking strategy (HMAC-SHA256).
# Same value + same key → same token, so masked data can be correlated.
# Required for `hash` (there is no default); generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MASKON_HASH_KEY=

# Maximum request body size in bytes; larger requests get 413. Default: 1 MB.
MASKON_MAX_BYTES=1000000
